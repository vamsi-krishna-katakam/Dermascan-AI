<%- include('../partials/header', { currentTab: 'doctors' }) %>

<main class="main-container">
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 class="page-title">Doctor Directory & Management</h1>
            <p class="page-subtitle">Configure verified clinical dermatologists and assign target disease specialties for automated patient triage.</p>
        </div>
        <button class="btn btn-primary" onclick="toggleDoctorModal()">
            + Register New Doctor
        </button>
    </div>

    <!-- Doctors Table Card -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">Active Clinical Specialists (<%= doctors.length %>)</div>
        </div>
        <div style="overflow-x: auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Doctor Name</th>
                        <th>Hospital & Experience</th>
                        <th>Target Specialties</th>
                        <th>Clinical Rating</th>
                        <th>Login Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% doctors.forEach(doc => { %>
                        <tr>
                            <td>
                                <div style="font-weight: 800; color: var(--primary);"><%= doc.name %></div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= doc.title %> • <code><%= doc.id %></code></div>
                            </td>
                            <td>
                                <div style="font-weight: 700; font-size: 0.82rem;"><%= doc.hospital %></div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= doc.experience_years %> years clinical experience</div>
                            </td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    <% doc.specialties.forEach(s => { %>
                                        <span style="font-size: 0.7rem; font-weight: 700; background: #e0f2fe; color: #0284c7; padding: 2px 8px; border-radius: 4px;">
                                            <%= s %>
                                        </span>
                                    <% }); %>
                                </div>
                            </td>
                            <td>
                                <div>⭐ <b><%= doc.rating %></b> / 5.0</div>
                            </td>
                            <td>
                                <code><%= doc.email %></code>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- ADD DOCTOR MODAL -->
<div id="addDoctorModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <div style="font-weight: 800; font-size: 1.1rem;">Register New Clinical Doctor</div>
            <button class="btn" style="padding: 2px 8px;" onclick="toggleDoctorModal()">✕</button>
        </div>
        <form class="modal-body" action="/admin/doctors" method="POST">
            <div class="form-group">
                <label class="form-label">Doctor Full Name</label>
                <input class="form-input" type="text" name="name" required placeholder="e.g. Dr. Kavita Nair" />
            </div>

            <div class="form-group">
                <label class="form-label">Professional Title</label>
                <input class="form-input" type="text" name="title" required value="Consultant Dermatologist & Dermato-Surgeon" />
            </div>

            <div class="form-group">
                <label class="form-label">Hospital / Clinic Affiliation</label>
                <input class="form-input" type="text" name="hospital" required placeholder="e.g. Apollo Tele-Health Center" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label class="form-label">Experience (Years)</label>
                    <input class="form-input" type="number" name="experience_years" value="10" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Specialties (Comma-separated)</label>
                    <input class="form-input" type="text" name="specialties" required value="Melanoma, Eczema, Vitiligo" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label class="form-label">Login Email</label>
                    <input class="form-input" type="email" name="email" required placeholder="doctor@dermascan.com" />
                </div>
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <input class="form-input" type="password" name="password" required value="123" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px;">
                <button type="button" class="btn" onclick="toggleDoctorModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Doctor Profile ➔</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleDoctorModal() {
        const modal = document.getElementById('addDoctorModal');
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }
</script>

<%- include('../partials/footer') %>
