    // =========================================================================
    // REAL-TIME WEBSOCKET PATIENT QUEUE (Ultra-Low Latency & Instant Turn Handover)
    // =========================================================================
    let ws = null;

    function initWebSocketQueue() {
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsUrl = protocol + '//' + window.location.host + '/ws/scanner';
        
        try {
            ws = new WebSocket(wsUrl);

            ws.onopen = () => {
                ws.send(JSON.stringify({
                    action: 'join',
                    patientId: '<%= user.id %>',
                    patientName: '<%= user.name %>'
                }));
            };

            ws.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    handleWebSocketMessage(data);
                } catch(err) {}
            };

            ws.onclose = () => {
                startPollingFallback();
            };

            ws.onerror = () => {
                startPollingFallback();
            };
        } catch(e) {
            startPollingFallback();
        }
    }

    function handleWebSocketMessage(data) {
        if (!data) return;

        // 1. If it is NOT my turn (waiting in queue)
        if (!data.is_my_turn) {
            handleQueueWaitingState(data);
            return;
        }

        // 2. If it IS my turn!
        handleTurnActiveState(data);

        // If telemetry is included, process detections
        if (data.type === 'TELEMETRY' || data.detections || data.gps) {
            processDetectionPayload(data);
        }
    }

