    // =========================================================================
    // AUTOMATIC LESION SNAPSHOT CAPTURE (Saves patient's exact skin photo)
    // =========================================================================
    async function captureLesionSnapshot() {
        if (isCapturingSnapshot) return;
        isCapturingSnapshot = true;
        try {
            // Priority 1: Instant snapshot from Cloud Simulation Canvas if active
            const cloudCanvas = document.getElementById('cloudViewfinderCanvas');
            if (cloudCanvas && cloudCanvas.style.display !== 'none') {
                try {
                    const dataUrl = cloudCanvas.toDataURL('image/jpeg', 0.85);
                    if (dataUrl && dataUrl.length > 500) {
                        applySnapshotToUI(dataUrl);
                        isCapturingSnapshot = false;
                        return;
                    }
                } catch(canvasErr) {}
            }

            // Priority 2: Instant HTML5 Canvas snapshot from active live stream
            const streamImg = document.getElementById('kioskStreamImg');
            if (streamImg && streamImg.style.display !== 'none' && streamImg.naturalWidth > 0) {
                try {
                    const canvas = document.createElement('canvas');
                    canvas.width = streamImg.naturalWidth;
                    canvas.height = streamImg.naturalHeight;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(streamImg, 0, 0);
                    const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
                    if (dataUrl && dataUrl.length > 500) {
                        applySnapshotToUI(dataUrl);
                        isCapturingSnapshot = false;
                        return;
                    }
                } catch(canvasErr) {}
            }

            // Priority 3: Fetch instant camera frame via Express proxy
            const endpoints = ['/api/scanner/snapshot'];
            for (const ep of endpoints) {
                try {
                    const res = await fetch(ep, { cache: 'no-store', signal: AbortSignal.timeout(1000) });
                    if (res.ok) {
                        const blob = await res.blob();
                        const reader = new FileReader();
                        reader.onloadend = () => {
                            applySnapshotToUI(reader.result);
                        };
                        reader.readAsDataURL(blob);
                        isCapturingSnapshot = false;
                        return;
                    }
                } catch(e) {}
            }
        } catch(e) {
        } finally {
            isCapturingSnapshot = false;
        }
    }

    function applySnapshotToUI(dataUrl) {
        if (!dataUrl) return;
        lastCapturedSnapshotData = dataUrl;
        const sampleImg = document.getElementById('detectedSampleImg');
        const placeholderIcon = document.getElementById('placeholderIcon');
        if (sampleImg) {
            sampleImg.src = dataUrl;
            sampleImg.style.display = 'block';
            if (placeholderIcon) placeholderIcon.style.display = 'none';
        }
        const modalImg = document.getElementById('modalImageUrl');
        if (modalImg) {
            modalImg.value = dataUrl;
        }
    }

    // =========================================================================
    // DYNAMIC DETECTION & DOCTORS UPDATER
    // =========================================================================
    function updateDetectionOutput(disease, confidence) {
        if (!disease) return;
        const matched = findRemedy(disease);
        if (!matched) return;

        const matchedKey = matched.key;
        const remedy = matched.remedy;
        currentDisease = matchedKey;
        currentConfidence = confidence;

        // 1. Update Disease Name & Color
        const diseaseEl = document.getElementById('detectedDiseaseName');
        diseaseEl.innerText = matchedKey;
        diseaseEl.style.color = remedy.color || '#ef4444';

        // 2. Update Confidence & Status Note
        document.getElementById('detectedConfidence').innerText = confidence + '%';
        const noteEl = document.getElementById('detectedStatusNote');
        if (noteEl) {
            noteEl.innerText = "(Active YOLO Target Lock)";
            noteEl.style.color = "#16a34a";
        }

        // 3. Automatically capture live lesion snapshot from camera!
        captureLesionSnapshot();
        if (!lastCapturedSnapshotData && sampleImages[matchedKey]) {
            const sampleImg = document.getElementById('detectedSampleImg');
            const placeholderIcon = document.getElementById('placeholderIcon');
            sampleImg.src = sampleImages[matchedKey];
            sampleImg.style.display = 'block';
            if (placeholderIcon) placeholderIcon.style.display = 'none';
            document.getElementById('modalImageUrl').value = sampleImages[matchedKey];
        }

        // 4. Update Severity Badge
        const badge = document.getElementById('aiSeverityBadge');
        badge.innerText = remedy.severity;
        badge.style.background = '';
        badge.style.color = '';
        if (remedy.severity.includes('High')) {
            badge.className = 'badge badge-danger';
        } else if (remedy.severity.includes('Moderate')) {
            badge.className = 'badge badge-warning';
        } else {
            badge.className = 'badge badge-info';
        }

        // 5. Update Do's List
        const dosList = document.getElementById('dosList');
        dosList.innerHTML = remedy.dos.map(d => `<li>${d}</li>`).join('');

        // 6. Update Don'ts List
        const dontsList = document.getElementById('dontsList');
        dontsList.innerHTML = remedy.donts.map(d => `<li>${d}</li>`).join('');

        // 7. Update Modal Hidden Inputs
        document.getElementById('modalDisease').value = matchedKey;
        document.getElementById('modalConfidence').value = confidence;
        document.getElementById('modalTargetConditionText').innerHTML = `Target Condition: <b style="color: ${remedy.color}">${matchedKey} (${confidence}% Match)</b>`;

        // 8. Re-render Doctors filtered by this newly detected disease
        renderRecommendedDoctors(matchedKey);
    }

