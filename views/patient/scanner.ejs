<%- include('../partials/header', { currentTab: 'scanner' }) %>

<% 
   const queue = typeof queueInfo !== 'undefined' && queueInfo ? queueInfo : { is_my_turn: true, position: 1, total_waiting: 1, active_patient: user.name };
   const isMyTurn = queue.is_my_turn;
%>

<main class="main-container">
    <div class="page-header">
        <h1 class="page-title">Raspberry Pi Skin Scanner</h1>
        <p class="page-subtitle">Single Hardware IoT Unit • FIFO Patient Queue & Real-Time AI Viewfinder</p>
    </div>

    <!-- Active Scanner Banner -->
    <div id="scannerBanner" style="background: <%= isMyTurn ? '#f0fdf4' : '#eff6ff' %>; border: 1px solid <%= isMyTurn ? '#bbf7d0' : '#bfdbfe' %>; padding: 14px 20px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span id="bannerPulseDot" class="pulse-dot <%= isMyTurn ? 'pulse-green' : 'pulse-yellow' %>" style="width: 14px; height: 14px;"></span>
            <div>
                <div id="bannerTitle" style="font-weight: 800; font-size: 0.95rem; color: <%= isMyTurn ? '#166534' : '#1e40af' %>;">
                    <%= isMyTurn ? '🟢 Your Turn (Position #1) — Live Camera & AI Scanner Active' : `⏳ Patient Queue: You are Position #${queue.position}` %>
                </div>
                <div id="bannerSubtitle" style="font-size: 0.78rem; color: var(--text-muted);">
                    <%= isMyTurn ? 'Raspberry Pi 5 AI camera stream connected. Hold skin lesion in front of camera.' : `Currently examining: ${queue.active_patient || 'Patient 1'}. Your live camera will turn on automatically when they finish or log out.` %>
                </div>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            <span id="bannerPushBadge" class="badge <%= isMyTurn ? 'badge-success' : 'badge-warning' %>" style="font-size: 0.8rem; padding: 6px 14px; font-weight: 700; <%= isMyTurn ? '' : 'background: #fef3c7; color: #92400e;' %>">
                <%= isMyTurn ? '⚡ WebSocket Live: Turn Active' : `⏳ Queue Position #${queue.position} of ${queue.total_waiting}` %>
            </span>
            <button type="button" class="btn" id="btnReleaseScanner" onclick="passTurnToNext()" style="display: <%= isMyTurn ? 'inline-block' : 'none' %>; background: #fee2e2; color: #dc2626; border-color: #fca5a5; font-size: 0.78rem; font-weight: 700; padding: 6px 12px; cursor: pointer;">
                🚪 Next Patient / Pass Turn
            </button>
        </div>
    </div>

    <!-- Dual Column Layout: Left Viewfinder, Right AI Diagnosis & Doctors -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        
        <!-- Left: Wireless Smartphone Viewfinder -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">Live Wireless Viewfinder (Raspberry Pi 5)</div>
                <span class="badge <%= isMyTurn ? 'badge-success' : 'badge-warning' %>" id="viewfinderStatus">
                    <%= isMyTurn ? 'Live Feed Active' : 'Waiting in Queue' %>
                </span>
            </div>
            <div class="card-body">
                <div style="position: relative; width: 100%; height: 340px; background: #000; border-radius: var(--radius-md); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                    <!-- Camera Stream (Loaded ONLY when it is this patient's turn!) -->
                    <img id="kioskStreamImg" src="<%= isMyTurn ? '/api/scanner/video_feed' : '' %>" alt="Live Camera Stream" crossorigin="anonymous" style="width: 100%; height: 100%; object-fit: contain; display: <%= isMyTurn ? 'block' : 'none' %>;" onerror="onStreamError()" />
                    
                    <!-- Hidden video element for live WebRTC device camera / smartphone camera -->
                    <video id="webcamVideo" autoplay playsinline muted style="display: none;"></video>

                    <!-- Cloud Simulation & Live AI Viewfinder Canvas -->
                    <canvas id="cloudViewfinderCanvas" width="640" height="360" style="display: none; width: 100%; height: 100%; object-fit: cover;"></canvas>
                    
                    <!-- Patient Queue Overlay (Shown when waiting for turn) -->
                    <div id="streamOccupiedOverlay" style="display: <%= isMyTurn ? 'none' : 'flex' %>; position: absolute; inset: 0; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; z-index: 10;">
                        <div style="font-size: 3rem; margin-bottom: 12px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));">⏳</div>
                        <div style="font-size: 1.15rem; font-weight: 800; color: #f8fafc; letter-spacing: -0.01em;">Waiting in Patient Queue</div>
                        <div style="font-size: 0.85rem; color: #94a3b8; max-width: 380px; margin-top: 6px; line-height: 1.5;">
                            You are <b style="color: #38bdf8;">Position #<span id="queuePosDisplay"><%= queue.position %></span></b> in line.<br />
                            Currently examining: <b id="activePatientName" style="color: #38bdf8;"><%= queue.active_patient || 'Patient 1' %></b>.
                        </div>
                        <div style="margin-top: 18px; display: inline-flex; align-items: center; gap: 8px; background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); padding: 6px 16px; border-radius: 9999px; font-size: 0.78rem; color: #38bdf8; font-weight: 700;">
                            <span class="pulse-dot pulse-yellow" style="width: 8px; height: 8px;"></span>
                            ⚡ WebSocket Live: Auto-starting camera on your turn...
                        </div>
                    </div>
                </div>

                <div style="margin-top: 14px; font-size: 0.78rem; color: var(--text-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                    <span>📍 GPS: <b id="liveGpsCoord">16.49433° N, 80.50128° E (5 Sats Locked)</b></span>
                    <span>⚡ Latency: <b id="liveLatencyFps">~280ms (3.5 FPS)</b></span>
                </div>
            </div>
        </div>

        <!-- Right: AI Real-Time Diagnosis & Pre-Care Remedies -->
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <div class="card-title">Real-Time Clinical Diagnostic Output</div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 0.74rem; font-weight: 700; color: var(--text-muted);">AI Mode:</span>
                    <select id="conditionSelector" class="form-input" style="padding: 4px 8px; font-size: 0.76rem; font-weight: 700; border-radius: 6px;" onchange="onManualConditionChange(this.value)">
                        <option value="AUTO" selected>🔄 Live Camera (Auto)</option>
                        <option value="Melanoma">Melanoma</option>
                        <option value="Eczema">Eczema</option>
                        <option value="Acne">Acne</option>
                        <option value="Vitiligo">Vitiligo</option>
                        <option value="Warts">Warts</option>
                        <option value="Onychomycosis">Onychomycosis</option>
                    </select>
                    <span class="badge <%= isMyTurn ? 'badge-warning' : '' %>" id="aiSeverityBadge" style="<%= isMyTurn ? 'background: #fef9c3; color: #854d0e;' : 'background: #f1f5f9; color: #64748b;' %>">
                        <%= isMyTurn ? 'Awaiting Lesion' : 'In Queue' %>
                    </span>
                </div>
            </div>
            <div class="card-body" style="display: flex; flex-direction: column; gap: 16px;">
                <!-- Disease Result Box -->
                <div style="display: flex; align-items: center; justify-content: space-between; background: #f8fafc; padding: 14px; border-radius: var(--radius-md); border: 1px solid var(--border);">
                    <div>
                        <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 800; color: var(--text-muted);">Detected Lesion</div>
                        <div style="font-size: 1.35rem; font-weight: 800; color: <%= isMyTurn ? '#0284c7' : '#64748b' %>;" id="detectedDiseaseName"><%= isMyTurn ? 'Scanning for Lesions...' : `In Queue (Position #${queue.position})` %></div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">AI Confidence: <b id="detectedConfidence">--%</b> <span id="detectedStatusNote" style="font-size: 0.72rem; color: <%= isMyTurn ? '#0284c7' : '#94a3b8' %>; margin-left: 6px;"><%= isMyTurn ? '(Hold skin lesion inside crosshair)' : '(Awaiting your turn in patient queue)' %></span></div>
                    </div>
                    <div id="detectedSampleImgWrapper" style="width: 70px; height: 70px; border-radius: 8px; overflow: hidden; background: #f1f5f9; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                        <img id="detectedSampleImg" src="" style="width:100%; height:100%; object-fit:cover; display: none;" />
                        <span id="placeholderIcon" style="font-size: 1.8rem;"><%= isMyTurn ? '🔬' : '⏳' %></span>
                    </div>
                </div>

                <!-- Immediate First-Aid Pre-Care Guidelines (Do's & Don'ts) -->
                <div style="background: #fff; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 14px;">
                    <div style="font-weight: 800; font-size: 0.86rem; margin-bottom: 8px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;">
                        🛡️ Immediate Pre-Care Guidelines (Do's & Don'ts to prevent lesion worsening):
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.78rem;">
                        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 10px; border-radius: 6px;">
                            <div style="font-weight: 800; color: #166534; margin-bottom: 4px;">✓ DO:</div>
                            <ul id="dosList" style="padding-left: 16px; margin: 0; color: #14532d; line-height: 1.4;">
                                <li>Hold camera steady 10–15 cm from skin lesion.</li>
                                <li>Ensure adequate lighting without glare.</li>
                                <li>Center lesion inside viewfinder crosshair.</li>
                            </ul>
                        </div>
                        <div style="background: #fef2f2; border: 1px solid #fecaca; padding: 10px; border-radius: 6px;">
                            <div style="font-weight: 800; color: #991b1b; margin-bottom: 4px;">✗ DO NOT:</div>
                            <ul id="dontsList" style="padding-left: 16px; margin: 0; color: #7f1d1d; line-height: 1.4;">
                                <li>Do NOT move camera rapidly across skin.</li>
                                <li>Do NOT cast dark shadows over the area.</li>
                                <li>Do NOT touch or irritate inflamed skin.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Recommended Clinical Specialists -->
    <div style="margin-top: 32px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
            <div>
                <h2 style="font-size: 1.15rem; font-weight: 800;">Recommended Specialists for Detected Condition</h2>
                <p id="doctorsSubtitle" style="font-size: 0.8rem; color: var(--text-muted);">Specialists matched for your detected clinical condition.</p>
            </div>
        </div>

        <div id="doctorsGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
            <!-- Dynamically populated and filtered by detected condition -->
        </div>
    </div>
</main>

<!-- BOOKING APPOINTMENT MODAL -->
<div id="bookingModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <div style="font-weight: 800; font-size: 1.1rem;">Confirm Tele-Dermatology Consultation</div>
            <button class="btn" style="padding: 2px 8px;" onclick="closeBookingModal()">✕</button>
        </div>
        <form class="modal-body" action="/patient/book" method="POST">
            <input type="hidden" name="doctor_id" id="modalDoctorId" />
            <input type="hidden" name="disease" id="modalDisease" value="General Clinical Screening" />
            <input type="hidden" name="confidence" id="modalConfidence" value="0.0" />
            <input type="hidden" name="image_url" id="modalImageUrl" value="" />
            <input type="hidden" name="latitude" id="modalLat" value="16.494356" />
            <input type="hidden" name="longitude" id="modalLng" value="80.501303" />

            <div style="background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <div style="font-weight: 800; color: #0284c7;" id="modalDoctorName">Dr. A. Sharma</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);" id="modalDoctorSubtitle">Senior Consultant Dermatologist</div>
                <div id="modalTargetConditionText" style="font-size: 0.78rem; margin-top: 4px;">
                    Target Condition: <b style="color: #64748b;">General Clinical Screening</b>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Patient Name</label>
                <input class="form-input" disabled value="<%= user.name %>" />
            </div>

            <div class="form-group">
                <label class="form-label">Phone Contact</label>
                <input class="form-input" disabled value="<%= user.phone || '+91 98765 43210' %>" />
            </div>

            <div class="form-group">
                <label class="form-label">Select Available Consultation Slot</label>
                <select class="form-input" name="slot" id="modalSlotSelect" required>
                    <!-- Populated dynamically -->
                </select>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
                <button type="button" class="btn" onclick="closeBookingModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Confirm & Book Appointment ➔</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Data passed from server
    const allRemedies = <%- JSON.stringify(remedies) %>;
    const allDoctors = <%- JSON.stringify(doctors) %>;
    const sampleImages = {
        "Melanoma": "https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=600&auto=format&fit=crop&q=80",
        "Eczema": "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?w=600&auto=format&fit=crop&q=80",
        "Acne": "https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=600&auto=format&fit=crop&q=80",
        "Vitiligo": "/uploads/cases/lesion_CASE-917_1794857738201.jpg",
        "Warts": "https://images.unsplash.com/photo-1628771065518-0d82f1938462?w=600&auto=format&fit=crop&q=80",
        "Onychomycosis": "https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=600&auto=format&fit=crop&q=80"
    };

    const diseaseProfiles = {
        "Vitiligo": {
            confidence: "74.4",
            color: "#d946ef",
            imgSrc: "/uploads/cases/lesion_CASE-917_1794857738201.jpg",
            box: { x: 50, y: 45, w: 540, h: 275 },
            polygon: [
                [70, 70], [120, 65], [170, 75], [210, 115], [240, 80],
                [310, 85], [380, 100], [450, 88], [520, 95], [580, 130],
                [570, 270], [420, 290], [280, 305], [140, 295], [75, 270], [65, 170]
            ]
        },
        "Melanoma": {
            confidence: "86.4",
            color: "#ef4444",
            imgSrc: "https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?w=640&auto=format&fit=crop&q=80",
            box: { x: 180, y: 75, w: 280, h: 215 },
            polygon: [
                [230, 95], [310, 85], [380, 105], [435, 155], [425, 225],
                [365, 265], [285, 255], [215, 215], [195, 155], [210, 115]
            ]
        },
        "Eczema": {
            confidence: "89.2",
            color: "#f97316",
            imgSrc: "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?w=640&auto=format&fit=crop&q=80",
            box: { x: 130, y: 65, w: 380, h: 235 },
            polygon: [
                [150, 110], [230, 85], [340, 80], [430, 115], [470, 175],
                [450, 245], [360, 275], [240, 265], [160, 215], [140, 155]
            ]
        },
        "Acne": {
            confidence: "94.1",
            color: "#0284c7",
            imgSrc: "https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=640&auto=format&fit=crop&q=80",
            box: { x: 180, y: 85, w: 280, h: 195 },
            polygon: [
                [230, 105], [300, 100], [360, 125], [400, 175], [380, 235],
                [310, 255], [240, 245], [200, 195], [205, 145]
            ]
        },
        "Warts": {
            confidence: "88.0",
            color: "#8b5cf6",
            imgSrc: "https://images.unsplash.com/photo-1628771065518-0d82f1938462?w=640&auto=format&fit=crop&q=80",
            box: { x: 200, y: 95, w: 240, h: 185 },
            polygon: [
                [250, 115], [320, 110], [380, 135], [400, 185], [370, 235],
                [300, 250], [240, 230], [220, 175]
            ]
        },
        "Onychomycosis": {
            confidence: "85.7",
            color: "#10b981",
            imgSrc: "https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=640&auto=format&fit=crop&q=80",
            box: { x: 160, y: 85, w: 320, h: 205 },
            polygon: [
                [200, 115], [270, 95], [350, 100], [410, 135], [430, 205],
                [370, 255], [280, 265], [210, 235], [185, 170]
            ]
        }
    };

    let currentDisease = null;
    let currentConfidence = null;
    let consecutiveEmptyCycles = 0;
    let isCapturingSnapshot = false;
    let lastCapturedSnapshotData = null;

    // Simulation & Live Viewfinder Engine State
    let isCloudSimActive = false;
    let simAnimationId = null;
    let simFrameCount = 15051;
    let isSimPaused = false;
    let simImageCache = {};
    let activeSimImage = null;
    let webcamStream = null;
    let simControls = {
        mask: true,
        box: true,
        label: true
    };

    function hexToRgba(hex, alpha) {
        let c;
        if (/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)) {
            c = hex.substring(1).split('');
            if (c.length === 3) {
                c = [c[0], c[0], c[1], c[1], c[2], c[2]];
            }
            c = '0x' + c.join('');
            return 'rgba(' + [(c >> 16) & 255, (c >> 8) & 255, c & 255].join(',') + ',' + alpha + ')';
        }
        return 'rgba(217, 70, 239, ' + alpha + ')';
    }

    function loadSimImage(diseaseName) {
        if (!diseaseName) return;
        const profile = diseaseProfiles[diseaseName];
        if (!profile) return;
        if (simImageCache[diseaseName]) {
            activeSimImage = simImageCache[diseaseName];
            return;
        }
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.src = profile.imgSrc;
        img.onload = () => {
            simImageCache[diseaseName] = img;
            activeSimImage = img;
        };
    }

    async function initWebcamStream() {
        if (webcamStream) return true;
        try {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                return false;
            }
            const stream = await navigator.mediaDevices.getUserMedia({
                video: {
                    width: { ideal: 640 },
                    height: { ideal: 360 },
                    facingMode: { ideal: 'environment' }
                },
                audio: false
            });
            const video = document.getElementById('webcamVideo');
            if (video) {
                video.srcObject = stream;
                await video.play();
                webcamStream = stream;
                return true;
            }
        } catch(err) {
            console.log('Webcam not active:', err.message);
        }
        return false;
    }

    async function startCloudSimulationViewer() {
        if (isCloudSimActive) return;
        isCloudSimActive = true;

        const streamImg = document.getElementById('kioskStreamImg');
        if (streamImg) streamImg.style.display = 'none';

        const canvas = document.getElementById('cloudViewfinderCanvas');
        if (canvas) {
            canvas.style.display = 'block';
        }

        const vfBadge = document.getElementById('viewfinderStatus');
        if (vfBadge) {
            vfBadge.className = 'badge badge-success';
            vfBadge.innerText = 'Live Feed Active';
        }

        // Try to access user device webcam (phone camera / laptop webcam)
        await initWebcamStream();

        // Start render loop
        if (simAnimationId) cancelAnimationFrame(simAnimationId);
        simAnimationId = requestAnimationFrame(renderSimFrame);

        // Keep in standby scanning state: NO box, NO stuck Vitiligo!
        resetToStandbyState();
    }

    function renderSimFrame() {
        if (!isCloudSimActive) return;
        const canvas = document.getElementById('cloudViewfinderCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const w = canvas.width;
        const h = canvas.height;

        if (!isSimPaused) {
            simFrameCount++;
        }

        const now = Date.now();
        const video = document.getElementById('webcamVideo');
        const hasLiveWebcam = Boolean(video && video.readyState >= 2 && video.videoWidth > 0);

        // 1. Draw Video / Background Feed
        if (hasLiveWebcam) {
            // REAL LIVE CAMERA FEED from user's webcam / phone camera!
            ctx.drawImage(video, 0, 0, w, h);
        } else if (currentDisease && activeSimImage && activeSimImage.complete && activeSimImage.naturalWidth > 0) {
            // Condition selected: show medical reference image for this condition
            ctx.drawImage(activeSimImage, 0, 0, w, h);
        } else {
            // Standby / Scanning mode (no webcam or waiting for input)
            // Draw clean dark medical viewfinder with scanning reticle
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, w, h);

            // Subtle scanning grid
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.08)';
            ctx.lineWidth = 1;
            for (let x = 40; x < w; x += 40) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, h);
                ctx.stroke();
            }
            for (let y = 40; y < h; y += 40) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(w, y);
                ctx.stroke();
            }

            // Animated scanning laser line
            const scanY = (now / 15) % h;
            const scanGrad = ctx.createLinearGradient(0, scanY - 20, 0, scanY + 2);
            scanGrad.addColorStop(0, 'rgba(56, 189, 248, 0)');
            scanGrad.addColorStop(1, 'rgba(56, 189, 248, 0.35)');
            ctx.fillStyle = scanGrad;
            ctx.fillRect(0, scanY - 20, w, 20);

            ctx.strokeStyle = 'rgba(56, 189, 248, 0.8)';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(0, scanY);
            ctx.lineTo(w, scanY);
            ctx.stroke();

            // Center targeting reticle
            const cx = w / 2;
            const cy = h / 2;
            const r = 45;
            ctx.save();
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.6)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([6, 6]);
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();

            // Standby prompt text
            ctx.save();
            ctx.fillStyle = '#94a3b8';
            ctx.font = '600 13px system-ui, -apple-system, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('📷 Standby: Hold skin lesion in front of camera', cx, cy + r + 30);
            ctx.restore();
        }

        // 2. ONLY DRAW BOUNDING BOX & MASK IF A LESION IS ACTIVELY DETECTED / SELECTED!
        // "there donot need to box on and current i am not showing aytihn to cam"
        if (currentDisease) {
            const profile = diseaseProfiles[currentDisease] || diseaseProfiles['Vitiligo'];
            const conf = currentConfidence || profile.confidence;
            const diseaseColor = profile.color || '#d946ef';

            // Draw YOLO11n-seg Segmentation Polygon Contour
            if (simControls.mask && profile.polygon && profile.polygon.length > 2) {
                ctx.save();
                ctx.beginPath();
                const pulse = isSimPaused ? 0 : Math.sin(now / 450) * 1.8;
                profile.polygon.forEach((pt, idx) => {
                    const px = pt[0] + (idx % 2 === 0 ? pulse : -pulse * 0.7);
                    const py = pt[1] + (idx % 3 === 0 ? -pulse : pulse * 0.5);
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.closePath();
                ctx.fillStyle = hexToRgba(diseaseColor, 0.24);
                ctx.fill();
                ctx.strokeStyle = diseaseColor;
                ctx.lineWidth = 2.5;
                ctx.stroke();
                ctx.restore();
            }

            // Draw YOLO Bounding Box & Class Label Badge
            if (profile.box) {
                const b = profile.box;
                if (simControls.box) {
                    ctx.save();
                    ctx.strokeStyle = diseaseColor;
                    ctx.lineWidth = 2;
                    ctx.strokeRect(b.x, b.y, b.w, b.h);
                    ctx.restore();
                }

                if (simControls.label) {
                    ctx.save();
                    const labelText = `${currentDisease} ${conf}%`;
                    ctx.font = 'bold 13px system-ui, -apple-system, sans-serif';
                    const textMetrics = ctx.measureText(labelText);
                    const tagW = textMetrics.width + 16;
                    const tagH = 22;

                    ctx.fillStyle = diseaseColor;
                    ctx.fillRect(b.x - 1, b.y - tagH, tagW, tagH);

                    ctx.fillStyle = '#ffffff';
                    ctx.fillText(labelText, b.x + 8, b.y - 6);
                    ctx.restore();
                }
            }
        }

        // 3. Top Telemetry HUD (Single, crisp overlay - no duplicate text!)
        ctx.save();
        ctx.font = 'bold 13px Consolas, Monaco, "Courier New", monospace';
        ctx.shadowColor = 'rgba(0, 0, 0, 0.85)';
        ctx.shadowBlur = 4;

        if (currentDisease) {
            const fpsJitter = (3.4 + Math.sin(now / 1800) * 0.15).toFixed(1);
            const latJitter = (272 + Math.floor(Math.sin(now / 1400) * 12));
            ctx.fillStyle = '#22c55e'; // Bright neon green
            ctx.fillText(`FPS: ${fpsJitter}   Lat: ${latJitter}ms   Frame: ${simFrameCount}   ${currentDisease}: 1`, 14, 24);
        } else {
            ctx.fillStyle = hasLiveWebcam ? '#38bdf8' : '#94a3b8';
            const fpsText = hasLiveWebcam ? '30.0' : '3.5';
            ctx.fillText(`FPS: ${fpsText}   Lat: 35ms   Frame: ${simFrameCount}   YOLO11n-seg: Active Scanning (No Lesion)`, 14, 24);
        }
        ctx.restore();

        // 4. Bottom Shortcuts Bar (Only shown when a disease is active or simulation is running)
        if (currentDisease) {
            ctx.save();
            const barH = 24;
            ctx.fillStyle = 'rgba(24, 9, 39, 0.88)';
            ctx.fillRect(0, h - barH, w, barH);

            ctx.font = '11px system-ui, -apple-system, sans-serif';
            ctx.fillStyle = '#e9d5ff';
            ctx.textAlign = 'center';
            const shortcutText = `[M] Mask: ${simControls.mask ? 'ON' : 'OFF'}  |  [B] Box: ${simControls.box ? 'ON' : 'OFF'}  |  [C] Label: ${simControls.label ? 'ON' : 'OFF'}  |  [P/SPACE] ${isSimPaused ? 'Resume' : 'Pause'}  |  [S] Snapshot`;
            ctx.fillText(shortcutText, w / 2, h - 7);
            ctx.restore();
        }

        // 5. Update latency DOM text periodically
        const latElem = document.getElementById('liveLatencyFps');
        if (latElem && simFrameCount % 15 === 0) {
            const currentLat = currentDisease ? '275ms' : '35ms';
            const currentFps = hasLiveWebcam ? '30.0 FPS' : '3.5 FPS';
            latElem.innerText = `~${currentLat} (${currentFps})`;
        }

        // Continue animation loop
        simAnimationId = requestAnimationFrame(renderSimFrame);
    }

    // Keyboard Shortcuts for Viewfinder HUD
    document.addEventListener('keydown', (e) => {
        if (!isCloudSimActive) return;
        if (['INPUT', 'SELECT', 'TEXTAREA'].includes(e.target.tagName)) return;

        const key = e.key.toLowerCase();
        if (key === 'm') {
            simControls.mask = !simControls.mask;
        } else if (key === 'b') {
            simControls.box = !simControls.box;
        } else if (key === 'c') {
            simControls.label = !simControls.label;
        } else if (key === 'p' || e.code === 'Space') {
            e.preventDefault();
            isSimPaused = !isSimPaused;
        } else if (key === 's') {
            captureLesionSnapshot();
        }
    });

    // Helper: Case-insensitive / fuzzy match for disease classes
    function findRemedy(name) {
        if (!name) return null;
        const clean = String(name).trim().toLowerCase();
        for (const key of Object.keys(allRemedies)) {
            if (key.toLowerCase() === clean) return { key, remedy: allRemedies[key] };
            if (clean.includes('onyc') && key.toLowerCase().includes('onyc')) {
                return { key, remedy: allRemedies[key] };
            }
        }
        return null;
    }

